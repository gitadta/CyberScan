    {
      "parameters": {
        "functionCode": "// Simulate scan results\nreturn {\n  json: {\n    vulnerabilities: [\n      {\n        id: \"vuln-001\",\n        cve: \"CVE-2023-1234\",\n        risk: \"High\",\n        ip: \"192.168.1.100\"\n      }\n    ]\n  }\n};"
      },
      "id": "cd19c1f3-4f80-480c-a059-b260e7b1d609",
      "name": "\ud83d\udd0d SCAN \u2013 Process Vulnerabilities",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -1184,
        1440
      ]
    },
    {
      "parameters": {
        "functionCode": "const vulns = $json.vulnerabilities;\n\nreturn vulns.map((v, i) => {\n  return {\n    json: {\n      ...v,\n      aiRisk: [6.5, 9.1][i] || 5,\n      path: [\"self-healing\", \"expert-review\", \"monitoring\"][i % 3],\n      lev: [0.93, 0.72][i] || 0.45\n    }\n  };\n});"
      },
      "id": "640b0db9-9793-46d8-a1d9-a035de137014",
      "name": "\ud83e\udd16 AI \u2013 Risk Evaluation",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -880,
        1440
      ]
    },
    {
      "parameters": {
        "functionCode": "const triage = {\n  self: [],\n  expert: [],\n  monitor: [],\n};\n\nconst assessed = $input.all();\n\nfor (const item of assessed) {\n  const v = item.json;\n  const levScore = v.lev || 0; // fallback if missing\n\n  if (levScore > 0.9) {\n    triage.expert.push({ ...v, levScore, levLabel: \"Critical\" });\n  } else if (levScore > 0.5) {\n    triage.self.push({ ...v, levScore, levLabel: \"High\" });\n  } else {\n    triage.monitor.push({ ...v, levScore, levLabel: \"Low\" });\n  }\n}\n\nreturn [{ json: triage }];"
      },
      "id": "2b8af3ee-ae91-4d4c-9c37-547f5e80379a",
      "name": "\ud83d\udcca AI \u2013 Triage Vulnerabilities",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -720,
        1440
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "0888daeb-abba-419a-a069-ec47d7eef9ab",
              "leftValue": "={{ Number($json.expert[0].lev) }}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -480,
        1440
      ],
      "id": "bd1fafed-1560-43f1-9f16-f57c949fa527",
      "name": "\ud83d\udea6 ALERT \u2013 LEV Trigger"
    },
    {
      "parameters": {
        "functionCode": "const t = $json;\nconst asArr = v => Array.isArray(v) ? v : [];\nconst expert  = asArr(t.expert);\nconst self    = asArr(t.self);\nconst monitor = asArr(t.monitor);\n\nconst all = [...expert, ...self, ...monitor];\nconst maxLEV = all.length ? Math.max(...all.map(v => Number(v?.lev ?? 0))) : 0;\n\nconst pickTopCVE = () => {\n  if (expert.length  && expert[0]?.cve)  return expert[0].cve;\n  if (self.length    && self[0]?.cve)    return self[0].cve;\n  if (monitor.length && monitor[0]?.cve) return monitor[0].cve;\n  return \"None\";\n};\n\nconst summary = {\n  expert:  expert.length,\n  self:    self.length,\n  monitor: monitor.length,\n  total:   expert.length + self.length + monitor.length,\n  timestamp: t.timestamp ?? new Date().toISOString(),\n  topCVE: pickTopCVE(),\n  maxLEV\n};\n\n// build HTML email body\nconst emailBody = `\n  <h2>\ud83d\udee1\ufe0f Vulnerability Assessment Report</h2>\n  <p><strong>\ud83d\udcc5 Timestamp:</strong> ${summary.timestamp}</p>\n  <ul>\n    <li><strong>\ud83d\udc64 Expert Group:</strong> ${summary.expert}</li>\n    <li><strong>\u270f\ufe0f Self Group:</strong> ${summary.self}</li>\n    <li><strong>\ud83d\udcca Monitor Group:</strong> ${summary.monitor}</li>\n    <li><strong>\ud83d\udcc8 Max LEV Score:</strong> ${summary.maxLEV}</li>\n    <li><strong>\ud83d\udca1 Top CVE:</strong> ${summary.topCVE}</li>\n  </ul>\n`;\n\nreturn [{\n  json: {\n    summary,\n    emailBody\n  }\n}];\n"
      },
      "id": "fe32b92a-32d4-483a-bfee-3d3ec5b52a23",
      "name": "\ud83d\udcdd REPORT \u2013 Generate Summary",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -720,
        1968
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4d6df3e2-210b-43d6-8b71-edcfed2bf1fc",
              "name": "groupData",
              "value": "={{ (() => {\n  const t = $json;\n  const ts = new Date().toISOString();\n\n  const lev   = Number(t.expert?.[0]?.lev ?? 0);\n  const risk  = (t.expert?.[0]?.risk ?? '').toLowerCase();\n  const label = (t.expert?.[0]?.levLabel ?? '').toLowerCase();\n\n  const groups = [];\n\n  const isExpert = lev >= 0.8 || risk === 'high' || label === 'critical';\n\n  if (!isExpert && lev < 0.4) {\n    groups.push({ timestamp: ts, group: \"self\", count: 1 });\n  } else if (!isExpert && lev < 0.8) {\n    groups.push({ timestamp: ts, group: \"monitor\", count: 1 });\n  } else {\n    groups.push({ timestamp: ts, group: \"expert\", count: 1 });\n  }\n\n  return groups;\n})() }}",
              "type": "array"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
