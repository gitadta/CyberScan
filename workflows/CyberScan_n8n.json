        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"uuid\": \"b81a11db-c0c6-3972-f298-23b38b8bc141b83f50d98587f71a\",\n  \"settings\": {\n    \"name\": \"Scan - {{ $json.hostName || $json.ipAddress }}\",\n    \"text_targets\": \"{{ $json.ipAddress }}\",\n    \"folder_id\": 3,\n    \"launch_now\": true\n  }\n}\n",
